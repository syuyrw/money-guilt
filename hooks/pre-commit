#!/bin/bash
# Blocks commits that contain secrets, or anything that could only have come
# from your real transaction data. Bypass on purpose with: git commit --no-verify
# (CLAUDE.md says never to.)
here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/.." && pwd)"
PY="$root/.venv/bin/python"; [ -x "$PY" ] || PY=python3

fail=0

blocked=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env$|(^|/)access_token\.txt$|\.db$|\.pem$|\.key$')
if [ -n "$blocked" ]; then
  echo "pre-commit: refusing to commit secret/data files:" >&2
  echo "$blocked" | sed 's/^/  /' >&2
  fail=1
fi

added=$(git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+' | grep -vE '^\+\+\+')
if echo "$added" | grep -qE '(access|link|public)-(sandbox|development|production)-[0-9a-f-]{20,}'; then
  echo "pre-commit: a Plaid token appears in the staged changes." >&2
  fail=1
fi
if echo "$added" | grep -qE 'PLAID_SECRET[[:space:]]*=[[:space:]]*[0-9a-fA-F]{20,}'; then
  echo "pre-commit: a Plaid secret appears in the staged changes." >&2
  fail=1
fi

# Transaction data must stay in the local database only.
"$PY" "$root/check_private_data.py" --staged || fail=1

[ "$fail" -eq 1 ] && echo "Remove it (or use --no-verify if this is intentional)." >&2
exit $fail
