# Copy to .env and fill in real values. .env is gitignored; never commit it.
# Keys: https://dashboard.plaid.com (Developers -> Keys)
PLAID_CLIENT_ID=your-client-id
PLAID_SECRET=your-sandbox-secret
PLAID_ENV=sandbox

# Optional: report the wasted-dollar total to your own collector (collector/server.py).
# Reporting also needs opt-in on each machine: python3 telemetry.py enable
# MONEY_GUILT_COLLECTOR_URL=https://your-collector.example
